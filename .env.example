# ─────────────────────────────────────────────────────────────────────
# Credenciais do Astrea (https://astrea.net.br)
# ─────────────────────────────────────────────────────────────────────
ASTREA_EMAIL=seu@email.com
ASTREA_PASSWORD=sua_senha_aqui

# ─────────────────────────────────────────────────────────────────────
# Autenticação da API (gere uma chave segura com: openssl rand -hex 32)
#
# Defina API_KEY (chave única, legada) E/OU API_KEYS (lista multi-chave,
# recomendada — uma chave por pessoa, com rótulo para auditoria/revogação).
# Formato de API_KEYS: chave[:label],chave[:label],...  (≥32 chars por chave)
# O label aparece nos logs de auditoria; a chave nunca é logada.
# ─────────────────────────────────────────────────────────────────────
API_KEY=gere_uma_chave_segura_aqui_com_pelo_menos_32_chars
# API_KEYS=chave_de_32_chars_ou_mais:fulano,outra_chave_de_32_chars:beltrano

# ─────────────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=0

# ─────────────────────────────────────────────────────────────────────
# Pool de Browsers (Playwright)
# ─────────────────────────────────────────────────────────────────────
# Número máximo de abas ativas simultâneas (1..5).
# Cada aba extra custa ~250 MB RAM E aumenta o risco da Astrea detectar
# uso indevido da conta (múltiplas abas paralelas na mesma sessão logada).
# 3 cobre o caso saudável; 5 é o teto para picos legítimos (múltiplos
# colaboradores + cron noturno). NÃO subir acima de 5.
BROWSER_POOL_SIZE=3

# Timeout em ms para operações do browser e para aguardar context disponível
BROWSER_TIMEOUT_MS=30000

# Encerra browser/contexto após esse tempo ocioso sem requisições.
# 0 desabilita idle shutdown.
BROWSER_IDLE_TTL_MS=900000

# Caminho explícito do browser. Deixe vazio para usar o browser gerenciado
# pelo Playwright (recomendado em Docker/Coolify).
# BROWSER_EXECUTABLE_PATH=

# false = abre janela do browser (útil para debug local)
BROWSER_HEADLESS=true

# Reutiliza a sessão do Astrea entre requisições (evita login repetido)
SESSION_REUSE=true

# ─────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────
# Janela de tempo em ms (padrão: 60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# Máximo de requisições por IP por janela (padrão: 50).
# Excedente recebe 429 com header Retry-After. O varredor de aniversariantes
# do consumer faz ~85 chamadas para 80 clientes em ~1 min — então com pool=5
# e cache de listarClientes, fica perto do limite mas não estoura em uso
# saudável; retry-storm 4× estoura imediatamente.
RATE_LIMIT_MAX_REQUESTS=50

# ─────────────────────────────────────────────────────────────────────
# Fila de Requisições (RequestQueue)
# ─────────────────────────────────────────────────────────────────────
# Tamanho máximo da fila de espera (rejeita com 503 quando cheia)
QUEUE_MAX_SIZE=20

# Timeout em ms para espera na fila (padrão: 60000 = 1 minuto)
QUEUE_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────
# Tenant do Astrea (necessário para chamadas GCP Endpoints / users API)
# ─────────────────────────────────────────────────────────────────────
ASTREA_TENANT_ID=6692712561442816

# ─────────────────────────────────────────────────────────────────────
# LLM Fallback — auto-recuperação de scraping
# Configure ao menos uma chave. O provedor é detectado automaticamente
# pela presença da chave, ou forçado com LLM_PROVIDER.
# ─────────────────────────────────────────────────────────────────────

# Anthropic (Claude Haiku — recomendado)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google (Gemini 1.5 Flash)
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-1.5-flash

# Força um provedor específico (opcional): anthropic | openai | google
# LLM_PROVIDER=anthropic

# ─────────────────────────────────────────────────────────────────────
# Notificação de incidentes por email (SMTP)
# ─────────────────────────────────────────────────────────────────────
DEVELOPER_EMAIL=estevaoterci@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=email@gmail.com
# SMTP_PASS=app-password-do-gmail
